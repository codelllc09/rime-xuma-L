#!/usr/bin/env bash
# pre-commit — 機械門禁鉤子（2026-11-05 加固）
#
# 安裝（一次性；hooksPath 指向**入庫**的目錄，克隆後仍在）：
#     git config core.hooksPath lua/codelllc09/tools/hooks
#
# 繞過（請在提交信息說明理由，別靜默跳過）：
#     git commit --no-verify
#
# 守的是什麼：AGENTS.md 的紀律靠自律，靠不住的部分交給機械。把它變成
# 「不滿足就提交不了」，是「事後守衛」而不是「事後後悔」。
#   - 台賬衛生：四欄／時序／TSV↔JSONL 對賬（毫秒級，每次提交都跑）
#   - 全電池十項：白名單、未來日期、校驗單、HEAD 煙測、雙檢、留痕靜態、溯源、台賬
#     ——其中⑦溯源會抓到「改了 rulings／語料卻沒重跑管道」這類最常見的漏步驟
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "pre-commit：不在 git 倉庫內"; exit 1; }
TOOLS="$ROOT/lua/codelllc09/tools"
cd "$ROOT" || exit 1

if ! command -v python3 >/dev/null 2>&1; then
  echo "pre-commit：缺 python3，無法跑門禁。確保安裝或用 --no-verify 明確跳過。"
  exit 1
fi

# ── ① 台賬衛生（快，先擋最便宜的一類錯）────────────────────────
if ! python3 "$TOOLS/_ledger.py" --selfcheck >/tmp/rime-precommit-ledger.log 2>&1; then
  echo "✗ pre-commit：台賬衛生未過（詳見 /tmp/rime-precommit-ledger.log）"
  tail -5 /tmp/rime-precommit-ledger.log | sed 's/^/    /'
  echo "  修法：python3 $TOOLS/_ledger.py --selfcheck"
  exit 1
fi

# ── ② 全電池 ────────────────────────────────────────────────────
if ! ( cd "$TOOLS" && python3 check_consistency.py >/tmp/rime-precommit.log 2>&1 ); then
  echo "✗ pre-commit：機械門禁未過（詳見 /tmp/rime-precommit.log）"
  grep -E '^\[✗\]' /tmp/rime-precommit.log | sed 's/^/    /'
  tail -2 /tmp/rime-precommit.log | sed 's/^/    /'
  cat <<'TIP'

  常見修法：
    · ⑦溯源報輸入漂移 → 改了 rulings／語料／字表卻沒重跑生成器：
        cd lua/codelllc09/tools && python3 gen_freq_dict.py
    · ①白名單 → 新跟蹤文件要在 .gitignore 顯式放行（註釋須獨立成行）
    · ②未來日期 → 文檔/答辯寫了晚於今日的日期
    · ⑧台賬 → python3 _ledger.py --selfcheck
  確需跳過：git commit --no-verify（並在提交信息說明理由）
TIP
  exit 1
fi

# ── ③ 詞表改動提示（不阻塞，僅提醒別忘了對賬報告）──────────────
if git diff --cached --name-only | grep -qx 'xuma_L.dict.yaml'; then
  if ! git diff --cached --name-only | grep -q '^tmp/'; then
    echo "提示：本次提交改了 xuma_L.dict.yaml。AGENTS 要求產出複覈報告："
    echo "      python3 lua/codelllc09/tools/diff_report.py HEAD~1 HEAD"
    echo "      （tmp/ 已忽略，報告不必提交，但需生成供人過目）"
  fi
fi

exit 0
